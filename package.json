{
  "name": "skills",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "日常使用的 Skill 合集管理仓库：Skill 收纳、Web 管理台与 VuePress 文档",
  "workspaces": [
    "web/server",
    "web/client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm -w web/server run dev\" \"npm -w web/client run dev\"",
    "dev:server": "npm -w web/server run dev",
    "dev:client": "npm -w web/client run dev",
    "build": "npm -w web/server run build && npm -w web/client run build",
    "build:server-bin": "node scripts/build-server-bin.js",
    "start": "npm -w web/server run start",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/theme-default": "^2.0.0-rc.137",
    "concurrently": "^10.0.7",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "sass-embedded": "^1.108.2",
    "vuepress": "2.0.0-rc.31"
  }
}
